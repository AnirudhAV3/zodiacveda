# Local PostgreSQL connection for development; replace with your own value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# Public site origin, no trailing slash. Update when a custom domain is connected.
# All canonical URLs, sitemap URLs and structured-data URLs use this value.
NEXT_PUBLIC_SITE_URL=https://zodiacveda.netlify.app
SITE_URL=https://zodiacveda.netlify.app

# Optional verification tokens from search-engine webmaster tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# URL of your self-hosted LibreTranslate-compatible instance (for example, http://localhost:5000).
# Install the required language models on the instance; the picker lists 131 languages,
# but only languages supported by the configured instance can be translated.
LIBRETRANSLATE_URL=

# Optional server-side API key for instances that require one. Never use NEXT_PUBLIC_ here.
LIBRETRANSLATE_API_KEY=
